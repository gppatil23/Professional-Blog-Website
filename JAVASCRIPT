const form = document.getElementById('inputpart');
const transactionsList = document.getElementById('blogs');
const headingInput = document.getElementById('heading');
const blogInput = document.getElementById('blog');
const inputPart = document.getElementById('inputpart');
const pencil = document.getElementById('pencil');

let transactions = JSON.parse(localStorage.getItem('blogs')) || [];
updateTransactionsDOM();

form.addEventListener('submit', function (event) {
    event.preventDefault();

    const heading = headingInput.value.trim();
    const para = blogInput.value.trim();

    if (!heading || !para) {
        alert('Please fill out all fields correctly.');
        return;
    }

    const transaction = { heading, para };
    transactions.push(transaction);
    localStorage.setItem('blogs', JSON.stringify(transactions));
    updateTransactionsDOM();

    headingInput.value = '';
    blogInput.value = '';
    $("#inputpart").hide();
});

function updateTransactionsDOM() {
    transactionsList.innerHTML = '';

    transactions.forEach((transaction, index) => {
        const transactionElement = document.createElement('div');
        transactionElement.classList.add('transaction');
        transactionElement.innerHTML = `
            <div class="blog-header">
                <span class="blog-title">${transaction.heading}</span>
                <button class="deletebtn" data-index="${index}">Delete</button>
            </div>

            <p>${transaction.para}</p>
        `;
        transactionsList.appendChild(transactionElement);
    });
}

transactionsList.addEventListener('click', function (e) {
    if (e.target.classList.contains('deletebtn')) {
        const index = e.target.getAttribute('data-index');
        deleteTransaction(index);
    }
});

function deleteTransaction(index) {
    transactions.splice(index, 1);
    localStorage.setItem('blogs', JSON.stringify(transactions));
    updateTransactionsDOM();
}


pencil.addEventListener('click', function (e) {
    e.preventDefault();
    inputPart.classList.toggle('active');
});

$(function () {
    $("#inputpart").hide();
    $("#pencil").click(function (e) {
        e.preventDefault();
        $("#inputpart").slideToggle(100);
    });
});
