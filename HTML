<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Unique Blogs</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="topslide">
        <h1>Unique Blogs</h1>
    </div>

    <form id="inputpart">
        <input type="text" placeholder="Enter Heading of Blog" maxlength="100" id="heading">
        <textarea id="blog" rows="5" maxlength="10000" placeholder="Start Writing Your Blog Here..."></textarea>
        <button type="submit" id="submit">Submit</button>
    </form>

    <img src="pencil.png" alt="Toggle Input" id="pencil">

    <div id="blogs"></div>

    <script src="script.js"></script>
</body>
</html>
