body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background-color: #f0f2f5;
}

.topslide {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2vmax;
}

.topslide h1 {
    color: #5a189a;
    font-size: 3.5vw;
    letter-spacing: 5px;
    font-weight: 800;
}

#pencil {
    height: 3vmax;
    width: 3vmax;
    position: fixed;
    right: 2vmax;
    bottom: 2vmax;
    background-color: #e9f907d0;
    padding: 1.2vmax;
    border-radius: 10px;
    filter: invert();
    cursor: pointer;
}

#inputpart {
    background-color: rgb(31, 31, 34);
    display: flex;
    width: 40vw;
    flex-direction: column;
    position: fixed;
    bottom: 2%;
    border-radius: 20px;
    row-gap: 10px;
    left: 30%;
    padding: 15px 20px;
}

#inputpart.active {
    display: none;
}



#inputpart input,
#inputpart textarea {
    border: none;
    border-radius: 10px;
    padding: 10px;
    font-size: 1.2rem;
    font-weight: 600;
    background-color: whitesmoke;
}

#inputpart input::placeholder,
#inputpart textarea::placeholder {
    font-size: 1rem;
    font-weight: 600;
}

#submit {
    font-size: 1rem;
    width: 10rem;
    align-self: center;
    border: none;
    font-weight: 700;
    background-color: blue;
    color: aliceblue;
    border-radius: 20px;
    padding: 10px;
    cursor: pointer;
}

#submit:hover {
    background-color: rgb(8, 8, 150);
}

#blogs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(30%, 3fr));
    gap: 2vmax;
    padding: 2vmax;
}

.transaction {
    background-color: #fdfdfd;
    border-radius: 15px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
    padding: 2vmax;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.transaction:hover {
    transform: translateY(-5px);
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.3);
}

.transaction label {
    font-size: 1.5rem;
    color: #5a189a;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.transaction p {
    font-size: 1.2rem;
    color: #333;
    line-height: 1.6;
}

.deletebtn {
    border: 2px solid red;
    background-color: transparent;
    color: red;
    border-radius: 20px;
    padding: 0.5vmax 1vmax;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.deletebtn:hover {
    background-color: red;
    color: white;
}
.blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 1.5rem;
    font-weight: bold;
    color: #5a189a;
    margin-bottom: 1vmax;
}

.blog-title {
    flex-grow: 1;
    padding-right: 1vmax;
}
