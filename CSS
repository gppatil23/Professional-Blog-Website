body {
    margin: 0px;
    width: 100%;
    background: linear-gradient(90deg, rgba(254, 11, 11, 0.351), rgba(247, 157, 157, 0.343),  rgba(219, 46, 254, 0.351));
}

.topslide {
    display: flex;
    justify-content: center;
    width: 100%;
    align-items: center;
}

.topslide h1 {
    color: black;
    font-family: cursive;
    letter-spacing: 5px;
    font-weight: 800;
    font-size: 3.5vw;
    padding: 5px 100px;
}

#pencil {
    height: 3vmax;
    width: 3vmax;
    position: fixed;
    margin-left: 92vmax;
    background-color: aliceblue;
    padding: 1.2vmax;
    border-radius: 20px;
    box-shadow: 7px 7px 15px black;
    top: 85%;
    cursor: pointer;
}

#inputpart {
    background-color: rgb(31, 31, 34);
    display: flex;
    width: 40vw;
    flex-direction: column;
    position: fixed;
    bottom: 2%;
    border-radius: 20px;
    row-gap: 10px;
    left: 30%;
    padding: 15px 20px;
}
#inputpart:hover {
    cursor: pointer;
}

#inputpart input {
    border-radius: 10px;
    padding: 10px;
    border: none;
    font-size: 20px;
    background-color: whitesmoke;
    font-weight: 700;
}

#inputpart input::placeholder {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 700;
    font-size: 25px;

}

#inputpart textarea {
    border: none;
    border-radius: 10px;
    background-color: whitesmoke;
    padding: 10px;
    font-size: 20px;
    font-family: Arial, Helvetica, sans-serif;


}

#inputpart textarea::placeholder {
    font-size: 15px;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 600;
}

#submit {
    font-size: 20px;
    width: 10rem;
    align-self: center;
    border: none;
    font-weight: 700;
    background-color: blue;
    color: aliceblue;
    border-radius: 20px;
    padding: 10px;
    position: relative;
}

#submit:hover {
    background-color: rgb(8, 8, 150);
}

label {
    width: 100%;
    justify-content: space-between;
    align-items: center;
    display: flex;
}

#deletebtn {
    border: black solid 1px;
    border-radius: 5vmax;
    padding: 1vmax;
    font-weight: 800;
    font-size: 20px;
    float: right;
    cursor: pointer;
}

#blogs {
    width: 98%;
    height: auto;
    display: flex;
    padding: 1.5vmax 1vmax;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: space-between;
}

#blogs div {
    margin: .3vmax 0;
    padding: 1vmax 2vmax;
    box-shadow: .1vmax .1vmax 1vmax rgba(0, 0, 0, 0.588);
    border-radius: 10px;
    width: 99%;
    background-color: whitesmoke;
    min-height: 200px;
    display: flex;
    flex-wrap: nowrap;
    flex-grow: 3;
    flex-direction: column;
}

#blogs div label {
    font-size: 3vmax;
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 700;
}

#blogs div p {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 2vmax;
    line-break: auto;
}

::-webkit-scrollbar {
    width: 5px;
    background-color: black;

}

::-webkit-scrollbar-thumb {
    background: linear-gradient(rgba(254, 11, 11, 0.917), rgba(179, 1, 255, 0.837));
    border-radius: 50px;
}

@media (max-width:680px) {
    body {
        margin: 0;
        padding: 0;

    }

    .topslide {
        width: 100%;
    }

    .topslide h1 {
        font-size: 40px;
        text-align: center;
    }

    #pencil {
        right: 3%;
        height: 40px;
        width: 40px;
        background-color: aliceblue;
    }

    #inputpart {
        width: 75%;
        left: 10%;
        padding: 10px;
    }

    #inputpart div {
        display: none;
    }

    #blogs {
        width: 100%;
        padding: 0;
        margin: 0;
    }

    #blogs div {
        margin: 3px 10px;
    }

    #blogs div label {
        font-size: 25px;
    }

    #blogs div p {
        font-size: 18px;
    }

    #deletebtn {
        background-color: rgba(0, 0, 0, 0.075);
        border: none;
        font-size: 15px;
    }
}
